# Finales de línea: los scripts y archivos que se ejecutan DENTRO de los
# contenedores (Linux) deben quedar con LF aunque se clone en Windows.
# Sin esto, git en Windows los convierte a CRLF y las réplicas no arrancan
# ("bad interpreter").
* text=auto
*.sh   text eol=lf
*.sql  text eol=lf
*.conf text eol=lf
*.yml  text eol=lf
*.js   text eol=lf
Dockerfile text eol=lf
*.jar  binary
*.png  binary
mvnw   text eol=lf
*.cmd  text eol=crlf

# Librerías de terceros: se guardan idénticas a la versión oficial (sin cambiar fines de línea)
infra/nginx/html/consola/vendor/** -text
