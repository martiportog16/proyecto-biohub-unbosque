# Copiar este archivo como .env y cambiar las claves.
# .env NO se sube a GitHub (está en .gitignore).

# Dueño de la base (corre las migraciones)
DB_DUENO=biohub
DB_CLAVE_DUENO=biohub_dueno

# Un usuario por rol (privilegios mínimos, T-14)
DB_CLAVE_APP_CIENTIFICO=cientifico_cambiar
DB_CLAVE_APP_PUBLICO=publico_cambiar
DB_CLAVE_APP_BATCH=batch_cambiar

# Usuario de replicación entre la primaria y las réplicas
DB_CLAVE_REPLICADOR=replicador_cambiar

# Secreto para firmar los tokens de sesión (igual en todas las instancias, mínimo 32 caracteres)
JWT_SECRETO=cambiar-este-secreto-de-al-menos-32-caracteres

# Puerto por el que se entra a BioHub (Nginx, único punto de entrada)
PUERTO_BIOHUB=8080
